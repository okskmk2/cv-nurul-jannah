---
import ContactPage from "@/components/ContactPage.astro";
import { t, type Locale } from "@/i18n/dictionaries";
import { prefixedLocales } from "@/i18n/routing";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageSeo } from "@/lib/seo";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const seo = buildPageSeo({
  locale,
  path: "/contact",
  title: t(locale, "meta.contactTitle"),
  description: t(locale, "meta.contactDesc"),
});
---
<BaseLayout {...seo}>
  <ContactPage locale={locale} />
</BaseLayout>
