---
import House from "@lucide/astro/icons/house";
import SearchX from "@lucide/astro/icons/search-x";
import { t } from "@/i18n/dictionaries";
import { defaultLocale } from "@/i18n/routing";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageSeo } from "@/lib/seo";

const locale = defaultLocale;
const seo = buildPageSeo({
  locale,
  path: "/",
  title: "Page not found",
  description: t(locale, "meta.homeDesc"),
});
---
<BaseLayout {...seo}>
  <section class="mx-auto max-w-6xl px-4 py-24 text-center md:px-6">
    <span class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-full bg-brand-green/12 text-brand-green">
      <SearchX size={32} aria-hidden="true" />
    </span>
    <p class="mt-4 text-sm font-semibold uppercase tracking-wider text-brand-leaf">404</p>
    <h1 class="mt-2 text-3xl font-bold text-brand-forest">Page not found</h1>
    <p class="mt-3 text-brand-muted">
      The page you requested is not in the Moringga catalog.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-brand-green px-5 py-3 text-sm font-semibold text-white hover:bg-brand-forest"
    >
      <House size={16} aria-hidden="true" />
      {t(locale, "nav.home")}
    </a>
  </section>
</BaseLayout>
