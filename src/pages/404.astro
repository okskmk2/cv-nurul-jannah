---
import { t } from "@/i18n/dictionaries";
import { defaultLocale } from "@/i18n/routing";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageSeo } from "@/lib/seo";

const locale = defaultLocale;
const seo = buildPageSeo({
  locale,
  path: "/",
  title: "Page not found",
  description: t(locale, "meta.homeDesc"),
});
---
<BaseLayout {...seo}>
  <section class="mx-auto max-w-6xl px-4 py-24 text-center md:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-leaf">404</p>
    <h1 class="mt-2 text-3xl font-bold text-brand-forest">Page not found</h1>
    <p class="mt-3 text-brand-muted">
      The page you requested is not in the Moringga catalog.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-brand-green px-5 py-3 text-sm font-semibold text-white hover:bg-brand-forest"
    >
      {t(locale, "nav.home")}
    </a>
  </section>
</BaseLayout>
