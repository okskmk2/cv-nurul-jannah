---
import FileText from "@lucide/astro/icons/file-text";
import LocaleLink from "./LocaleLink.astro";
import { t, type Locale } from "@/i18n/dictionaries";

type Props = { locale: Locale };
const { locale } = Astro.props;
---
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-sage/40 bg-brand-cream/95 p-3 backdrop-blur md:hidden"
>
  <LocaleLink
    href="/contact"
    class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-green py-3 text-center text-sm font-semibold text-white shadow-md"
  >
    <FileText size={16} aria-hidden="true" />
    {t(locale, "cta.sticky")}
  </LocaleLink>
</div>
