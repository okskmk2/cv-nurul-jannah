---
import BrandLogo from "./BrandLogo.astro";
import LocaleLink from "./LocaleLink.astro";
import { LanguageSwitcher } from "./react/LanguageSwitcher";
import { t, type Locale } from "@/i18n/dictionaries";

type Props = { locale: Locale; pathname: string };
const { locale, pathname } = Astro.props;
const year = new Date().getFullYear();
const email = t(locale, "common.emailValue");
const whatsapp = t(locale, "common.whatsappValue");
const waDigits = whatsapp.replace(/\D/g, "");
---

<footer class="mt-auto bg-brand-forest text-brand-cream">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-2 md:px-6 lg:grid-cols-3"
  >
    <div>
      <div class="flex items-center gap-2.5">
        <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-cream p-1">
          <BrandLogo class="h-9 w-9" />
        </span>
        <span>
          <span class="block font-bold">CV. Nurul Jannah</span>
          <span class="block text-xs font-semibold uppercase tracking-wider text-brand-sage">
            Moringga
          </span>
        </span>
      </div>
      <p class="mt-3 max-w-xs text-sm text-brand-cream/80">
        {t(locale, "brand.tagline")}
      </p>
      <p class="mt-2 max-w-xs text-xs text-brand-cream/70">
        {t(locale, "footer.origin")}
      </p>
      <p class="mt-1 max-w-xs text-xs text-brand-sage">
        {t(locale, "footer.whatsappNote")}
      </p>
    </div>

    <div class="grid grid-cols-2 gap-6">
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-sage">
          {t(locale, "footer.links")}
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <LocaleLink href="/products" class="hover:text-white">
              {t(locale, "nav.products")}
            </LocaleLink>
          </li>
          <li>
            <LocaleLink href="/trust" class="hover:text-white">
              {t(locale, "nav.trust")}
            </LocaleLink>
          </li>
          <li>
            <LocaleLink href="/contact" class="hover:text-white">
              {t(locale, "nav.contact")}
            </LocaleLink>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-sage">
          {t(locale, "footer.contact")}
        </h3>
        <ul class="mt-3 space-y-2 text-sm text-brand-cream/90">
          <li>
            <a href={`mailto:${email}`} class="hover:text-white">{email}</a>
          </li>
          <li>
            <a
              href={`https://wa.me/${waDigits}`}
              class="hover:text-white"
              target="_blank"
              rel="noreferrer"
            >
              {whatsapp}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="lg:justify-self-end">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-sage">
        {t(locale, "footer.language")}
      </h3>
      <div class="mt-3">
        <LanguageSwitcher
          client:load
          locale={locale}
          pathname={pathname}
          variant="dark"
        />
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-brand-cream/60">
    © {year} CV. Nurul Jannah · Moringga. All rights reserved.
  </div>
</footer>
