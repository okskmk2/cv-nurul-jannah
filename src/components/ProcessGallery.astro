---
import LocaleLink from "./LocaleLink.astro";
import { processSteps } from "@/data/process";
import { t, type Locale } from "@/i18n/dictionaries";

type Props = { locale: Locale; showCta?: boolean };
const { locale, showCta = false } = Astro.props;
---

<section id="process" class="border-y border-brand-sage/30 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-brand-forest md:text-3xl">
          {t(locale, "process.title")}
        </h2>
        <p class="mt-2 text-brand-muted">{t(locale, "process.subtitle")}</p>
      </div>
      {showCta && (
        <LocaleLink
          href="/trust"
          class="text-sm font-semibold text-brand-green hover:text-brand-forest"
        >
          {t(locale, "process.cta")} →
        </LocaleLink>
      )}
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {processSteps.map((step, index) => (
        <figure class="overflow-hidden rounded-2xl border border-brand-sage/40 bg-white shadow-sm">
          <div class="relative aspect-[4/3] overflow-hidden bg-brand-cream">
            <img
              src={step.image}
              alt={t(locale, step.altKey)}
              width={1200}
              height={900}
              loading="lazy"
              class="h-full w-full object-cover"
            />
            <span
              class="absolute left-3 top-3 inline-flex h-8 min-w-8 items-center justify-center rounded-full bg-brand-forest/85 px-2 text-xs font-bold text-white"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
          <figcaption class="p-4">
            <h3 class="font-bold text-brand-forest">{t(locale, step.titleKey)}</h3>
            <p class="mt-1 text-sm text-brand-muted">{t(locale, step.bodyKey)}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
