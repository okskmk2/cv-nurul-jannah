---
import Download from "@lucide/astro/icons/download";
import Mail from "@lucide/astro/icons/mail";
import MessageCircle from "@lucide/astro/icons/message-circle";
import { ContactForm } from "./react/ContactForm";
import { t, type Locale } from "@/i18n/dictionaries";
import { isPlaceholderWhatsApp } from "@/lib/site";

type Props = { locale: Locale };
const { locale } = Astro.props;
const email = t(locale, "common.emailValue");
const whatsapp = t(locale, "common.whatsappValue");
const showWhatsapp = !isPlaceholderWhatsApp(whatsapp);
const waDigits = whatsapp.replace(/\D/g, "");
---

<section class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
  <div class="mb-8 max-w-2xl">
    <h1 class="text-3xl font-bold text-brand-forest md:text-4xl">
      {t(locale, "contact.title")}
    </h1>
    <p class="mt-3 text-brand-muted">{t(locale, "contact.subtitle")}</p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
    <ContactForm client:load locale={locale} />

    <aside class="space-y-4">
      <div class="rounded-2xl border border-brand-sage/50 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold text-brand-forest">
          {t(locale, "contact.direct")}
        </h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-start gap-3">
            <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-green/12 text-brand-green">
              <Mail size={16} aria-hidden="true" />
            </span>
            <div>
              <dt class="font-medium text-brand-muted">{t(locale, "contact.email")}</dt>
              <dd>
                <a
                  class="font-semibold text-brand-green hover:underline"
                  href={`mailto:${email}`}
                >
                  {email}
                </a>
              </dd>
            </div>
          </div>
          {showWhatsapp && (
          <div class="flex items-start gap-3">
            <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-green/12 text-brand-green">
              <MessageCircle size={16} aria-hidden="true" />
            </span>
            <div>
              <dt class="font-medium text-brand-muted">
                {t(locale, "contact.whatsapp")}
              </dt>
              <dd>
                <a
                  class="font-semibold text-brand-green hover:underline"
                  href={`https://wa.me/${waDigits}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  {whatsapp}
                </a>
              </dd>
            </div>
          </div>
          )}
        </dl>
        <a
          href="/catalog.pdf"
          download="CV-Nurul-Jannah-Moringa-Catalog.pdf"
          class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-green py-2.5 text-center text-sm font-semibold text-white hover:bg-brand-forest"
        >
          <Download size={16} aria-hidden="true" />
          {t(locale, "contact.downloadCatalog")}
        </a>
      </div>

      <div
        class="rounded-2xl bg-brand-cream p-5 text-sm text-brand-forest border border-brand-sage/40"
      >
        {t(locale, "contact.marketsBox")}
      </div>
    </aside>
  </div>
</section>
