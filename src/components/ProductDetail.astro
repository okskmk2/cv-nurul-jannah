---
import Download from "@lucide/astro/icons/download";
import FileText from "@lucide/astro/icons/file-text";
import CertMark from "./CertMark.astro";
import LocaleLink from "./LocaleLink.astro";
import type { Product } from "@/data/products";
import { productImagePath } from "@/data/products";
import { t, type Locale } from "@/i18n/dictionaries";

type Props = { product: Product; locale: Locale };
const { product, locale } = Astro.props;
const name = product.name[locale];
const alt = `${name} — Moringa kelor, CV. Nurul Jannah`;
---

<article class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
  <p class="mb-6 text-sm">
    <LocaleLink
      href="/products"
      class="font-semibold text-brand-green hover:text-brand-forest"
    >
      ← {t(locale, "products.back")}
    </LocaleLink>
  </p>
  <div class="grid gap-10 md:grid-cols-2">
    <div
      class="overflow-hidden rounded-3xl border border-brand-sage/40 bg-brand-cream shadow-sm"
    >
      <img
        src={productImagePath(product.slug)}
        alt={alt}
        width={1200}
        height={900}
        class="h-full w-full object-cover"
      />
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-brand-leaf">
        {product.sku}
      </p>
      <h1 class="mt-2 text-3xl font-bold text-brand-forest md:text-4xl">
        {name}
      </h1>
      <p class="mt-4 text-base text-brand-muted">
        {product.description[locale]}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
          <CertMark cert="organic" size="sm" alt={t(locale, "trust.organic")} />
          <CertMark cert="halal" size="sm" alt={t(locale, "trust.halal")} />
          <CertMark cert="pirt" size="sm" alt={t(locale, "trust.pirt")} />
        </div>
        <LocaleLink
          href="/trust#certs"
          class="inline-flex items-center gap-1 text-xs font-semibold text-brand-green hover:text-brand-forest hover:underline"
        >
          {t(locale, "products.viewCert")} →
        </LocaleLink>
      </div>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-brand-sage/40 bg-white p-4">
          <dt class="text-xs font-semibold uppercase tracking-wider text-brand-muted">
            {t(locale, "products.form")}
          </dt>
          <dd class="mt-1 font-medium text-brand-forest">
            {product.form[locale]}
          </dd>
        </div>
        <div class="rounded-2xl border border-brand-sage/40 bg-white p-4">
          <dt class="text-xs font-semibold uppercase tracking-wider text-brand-muted">
            {t(locale, "products.moq")}
          </dt>
          <dd class="mt-1 font-medium text-brand-forest">
            {product.moq}
          </dd>
        </div>
      </dl>
      <div class="mt-8 flex flex-wrap gap-3">
        <LocaleLink
          href={`/contact?product=${encodeURIComponent(product.slug)}`}
          class="inline-flex items-center gap-2 rounded-lg bg-brand-green px-5 py-3 text-sm font-semibold text-white hover:bg-brand-forest"
        >
          <FileText size={16} aria-hidden="true" />
          {t(locale, "products.inquire")}
        </LocaleLink>
        <a
          href="/catalog.pdf"
          download="CV-Nurul-Jannah-Moringa-Catalog.pdf"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-green bg-white px-5 py-3 text-sm font-semibold text-brand-green hover:bg-brand-sage/20"
        >
          <Download size={16} aria-hidden="true" />
          {t(locale, "contact.downloadCatalog")}
        </a>
      </div>
    </div>
  </div>
</article>
